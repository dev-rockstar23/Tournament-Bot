{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    "src/generated/**",
    ".next/**",
    "node_modules/**",
    "prisma/**"
  ],
  "rules": {
    "import/order": "off",
    "no-empty": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-this-alias": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "no-undef": "off",
    "no-unreachable": "warn"
  }
}
