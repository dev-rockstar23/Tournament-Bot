# Allow Prisma build scripts
enable-pre-post-scripts=true

# Hoist to make packages accessible
shamefully-hoist=true

# Allow build scripts for these packages (needed for Prisma engine download on Vercel)
approve-builds[]=@prisma/client
approve-builds[]=@prisma/engines
approve-builds[]=prisma
approve-builds[]=esbuild
approve-builds[]=msgpackr-extract
approve-builds[]=unrs-resolver
