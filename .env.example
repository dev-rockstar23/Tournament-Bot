# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Auth redirect URL (e.g. https://<ref>.supabase.co/auth/v1/callback)
Supabase_Auth_Callback=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=
# This MUST equal DISCORD_CLIENT_ID — needed for client-side bot invite URLs
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# PostgreSQL: use the Supabase Session Pooler URL for DATABASE_URL at runtime.
# Keep the Supabase direct connection URL in DIRECT_URL for Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Upstash Redis (HTTP REST client — used by @upstash/redis for caching/brute-force)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# BullMQ Redis (TCP connection — required by ioredis/BullMQ worker)
# Must be a redis:// or rediss:// URL pointing to a real TCP Redis endpoint.
# Do NOT use the Upstash REST URL here — it is HTTP-only and incompatible.
# For Upstash TLS: rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Feature flags
PAYMENTS_ENABLED=false
# Encryption key for storing sensitive credentials at rest (32-byte hex string)
ENCRYPTION_KEY=

# Sentry
SENTRY_DSN_WEB=
SENTRY_DSN_BOT=
SENTRY_DSN_WORKER=

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# ElevenLabs — optional, enables UI sound effects on the landing page
NEXT_PUBLIC_ELEVENLABS_API_KEY=
