DIRECT_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags
PAYMENTS_ENABLED=false

# Sentry
SENTRY_DSN_WEB=
SENTRY_DSN_BOT=
SENTRY_DSN_WORKER=

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=development
